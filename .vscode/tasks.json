{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build project",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false
		},
		{
			"label": "dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "stable preview server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev:stable"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start development preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}